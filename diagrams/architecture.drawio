        <mxCell id="sgtext" value="&#8226; ALB &#8212; :80 from internet&#10;&#8226; Task &#8212; :8080 from ALB group only&#10;&#8226; Endpoint &#8212; :443 from task group only&#10;&#8226; Task egress to S3 via prefix list&#10;Least privilege: no group allows 0.0.0.0/0&#10;inbound except the ALB." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1">
