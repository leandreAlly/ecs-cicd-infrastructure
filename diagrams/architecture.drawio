        <mxCell id="spectext" value="&#8226; ALB &#8212; :80 production, :9000 test&#10;&#8226; Tasks &#8212; auto scale 1&#8211;4, CPU target 60%&#10;&#8226; ECR &#8212; immutable tags, keeps 10 images&#10;&#8226; CodeDeploy &#8212; BLUE_GREEN, all at once,&#10;&#160;&#160; terminate blue after 5 min&#10;&#8226; Endpoints &#8212; S3 gateway, ECR api,&#10;&#160;&#160; ECR dkr, CloudWatch Logs&#10;&#8226; Logs &#8212; /ecs/ecs-cicd, 7 day retention&#10;&#8226; Private subnets &#8212; no NAT gateway&#10;&#8226; Deployment controller &#8212; CODE_DEPLOY" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;whiteSpace=wrap;spacingTop=0;" vertex="1" parent="1">
